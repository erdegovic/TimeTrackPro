NODE_ENV=development
APP_URL=http://127.0.0.1:5001
PORT=5001
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/timetrackpro_local
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BREVO_API_KEY=
SENDER_EMAIL=noreply@tickd.me
INVOICE_SENDER_EMAIL=invoice@tickd.me
CONTACT_EMAIL=noreply@tickd.me
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Tickd Ultimate AI (server only)
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-5.4-nano
OPENAI_AI_WRITING_MODEL=gpt-5.4-mini
# $2.00 monthly hard ceiling per Ultimate account, expressed in micro-dollars.
AI_MONTHLY_COST_LIMIT_MICROS=2000000

# Gmail send-only invoice delivery. Generate the encryption key once with:
# openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# Paddle Billing (use sandbox values until the end-to-end test passes)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_PRICE_ID=
PADDLE_ULTIMATE_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
PADDLE_ULTIMATE_ANNUAL_PRICE_ID=

# Optional staging slots while Paddle reviews the live account. The app does
# not read these directly; promote them to PADDLE_* only after live approval.
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_PRO_PRICE_ID=
PADDLE_LIVE_ULTIMATE_PRICE_ID=
PADDLE_LIVE_PRO_ANNUAL_PRICE_ID=
PADDLE_LIVE_ULTIMATE_ANNUAL_PRICE_ID=

# Encrypted backups (Cloudflare R2 or another S3-compatible private bucket)
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=12
BACKUP_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=tickd-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Generate once with: openssl rand -base64 32
ACCOUNT_BACKUP_ENCRYPTION_KEY=
